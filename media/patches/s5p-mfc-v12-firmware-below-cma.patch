+/*
+ * MFC v12 addresses every buffer from the firmware's base (RISC_BASE_ADDRESS)
+ * and fails a stream buffer that lies below it (error 0x37 at the sequence
+ * header). Without an IOMMU the firmware sits in CMA like every frame and
+ * stream buffer, so any buffer that lands in a hole further down fails: on
+ * the Exynos 9810 that was every video below about 1024x576. Put the
+ * firmware under all of CMA instead: alloc_contig_pages() takes the lowest
+ * free range of ZONE_DMA, which is ordinary RAM below the CMA area.
+ */
+static int s5p_mfc_alloc_low_firmware(struct s5p_mfc_dev *mfc_dev)
+{
+	struct device *dev = &mfc_dev->plat_dev->dev;
+	struct s5p_mfc_priv_buf *fw = &mfc_dev->fw_buf;
+	unsigned long nr = mfc_dev->variant->buf_size->fw >> PAGE_SHIFT;
+	struct page *page;
+	dma_addr_t dma;
+
+	page = alloc_contig_pages(nr, GFP_KERNEL | __GFP_DMA | __GFP_NOWARN,
+				  numa_mem_id(), NULL);
+	if (!page)
+		return -ENOMEM;
+	dma = dma_map_page(dev, page, 0, nr << PAGE_SHIFT, DMA_TO_DEVICE);
+	if (dma_mapping_error(dev, dma)) {
+		free_contig_range(page_to_pfn(page), nr);
+		return -ENOMEM;
+	}
+	if (dma >= mfc_dev->mem_base) {
+		/* no lower than the context buffers: no use */
+		dma_unmap_page(dev, dma, nr << PAGE_SHIFT, DMA_TO_DEVICE);
+		free_contig_range(page_to_pfn(page), nr);
+		return -ERANGE;
+	}
+	fw->low_page = page;
+	fw->virt = page_address(page);
+	fw->dma = dma;
+	fw->size = nr << PAGE_SHIFT;
+	mfc_dev->dma_base[BANK_L_CTX] = dma;
+	mfc_dev->dma_base[BANK_R_CTX] = dma;
+	dev_info(dev, "firmware at %pad, below every buffer\n", &dma);
+	return 0;
+}
